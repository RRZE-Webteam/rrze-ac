msgid "The requested file was not found."
msgstr "Die angeforderte Datei wurde nicht gefunden."

#: RRZE/AccessControl/Main.php:1310 RRZE/AccessControl/Main.php:1326
#: RRZE/AccessControl/Main.php:1355 RRZE/AccessControl/Main.php:1404
msgid "Not Found"
msgstr "Not Found"

#: RRZE/AccessControl/Main.php:1341
msgid "The request was due lack of client permission not performed."
msgstr "Die Anfrage wurde mangels Berechtigung des Clients nicht durchgeführt."

#: RRZE/AccessControl/Main.php:1342 RRZE/AccessControl/Main.php:1417
