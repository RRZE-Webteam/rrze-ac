#. Plugin Name of the plugin
msgid "RRZE Access Control"
msgstr "RRZE Access-Control"

#. Plugin URI of the plugin
msgid "https://gitlab.rrze.fau.de/rrze-webteam/rrze-ac"
msgstr "https://gitlab.rrze.fau.de/rrze-webteam/rrze-ac"

#. Description of the plugin
msgid ""
"Allows protection of files/documents through user and network related "
"functions."
msgstr ""
"Ermöglicht den Schutz von Dateien/Dokumenten durch benutzer- und "
"netzwerkbezogene Funktionen."

#. Author of the plugin
msgid "RRZE Webteam"
msgstr "RRZE Webteam"

#. Author URI of the plugin
msgid "https://blogs.fau.de/webworking/"
msgstr "https://blogs.fau.de/webworking/"

#: rrze-ac.php:60
msgid ""
"Your server is running PHP version %s. Please upgrade at least to PHP "
"version %s."
msgstr ""
"Ihre PHP-Version %s ist veraltet. Bitte aktualisieren Sie mindestens auf die "
"PHP-Version %s."

#: rrze-ac.php:65
msgid ""
"Your Wordpress version is %s. Please upgrade at least to Wordpress version "
"%s."
msgstr ""
"Ihre Wordpress-Version %s ist veraltet. Bitte aktualisieren Sie mindestens "
"auf die Wordpress-Version %s."

#: rrze-ac.php:70
msgid ""
"The Web server software is not compatible. Please use instead the Apache Web "
"server software."
msgstr ""
"Der Web-Server-Software ist nicht kompatibel. Bitte verwenden Sie "
"stattdessen den Apache-Web-Server-Software."

#: rrze-ac.php:75
msgid "The WordPress instance is not a MultiSite."
msgstr "Die Wordpress-Instanz ist keine Multisite."

#: rrze-ac.php:80
msgid "The Web server software does not support the Rewrite module."
msgstr "Der Web-Server-Software unterstützt das Rewrite-Modul nicht."

