#. Plugin Name of the plugin
msgid "RRZE Access Control"
msgstr "RRZE Access-Control"

#. Plugin URI of the plugin
msgid "https://gitlab.rrze.fau.de/rrze-webteam/rrze-ac"
msgstr "https://gitlab.rrze.fau.de/rrze-webteam/rrze-ac"

#. Description of the plugin
msgid ""
"Allows protection of files/documents through user and network related "
"functions."
msgstr ""
"Ermöglicht den Schutz von Dateien/Dokumenten durch benutzer- und "
"netzwerkbezogene Funktionen."

#. Author of the plugin
msgid "RRZE Webteam"
msgstr "RRZE Webteam"

#. Author URI of the plugin
msgid "https://blogs.fau.de/webworking/"
msgstr "https://blogs.fau.de/webworking/"

