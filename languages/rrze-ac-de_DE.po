#. translators: 1: Server PHP version number, 2: Required PHP version number.
#: rrze-ac.php:73
msgid ""
"The server is running PHP version %1$s. The Plugin requires at least PHP "
"version %2$s."
msgstr ""
"Auf dem Server wird die PHP-Version %1$s ausgeführt. Das Plugin erfordert "
"mindestens die PHP-Version %2$s."

#. translators: 1: Server WordPress version number, 2: Required WordPress version number.
#: rrze-ac.php:80
msgid ""
"The server is running WordPress version %1$s. The Plugin requires at least "
"WordPress version %2$s."
msgstr ""
"Auf dem Server wird die WordPress-Version %1$s ausgeführt. Das Plugin "
"erfordert mindestens die WordPress-Version %2$s."

#: rrze-ac.php:85
msgid ""
"The Web server software is not compatible. Please use instead the Apache Web "
"server software."
msgstr ""
"Der Web-Server-Software ist nicht kompatibel. Bitte verwenden Sie "
"stattdessen den Apache-Web-Server-Software."

#: rrze-ac.php:87
msgid "The Web server software does not support the Rewrite module."
msgstr "Der Web-Server-Software unterstützt das Rewrite-Modul nicht."

#: rrze-ac.php:89
msgid "The WordPress instance is not a MultiSite."
msgstr "Die Wordpress-Instanz ist keine Multisite."

