#. translators: %s is the path to the WP uploads directory
#: includes/Main.php:1289
msgid ""
"The newly specified path %s is absolute. The new path must be a path "
"relative to the WP uploads directory."
msgstr ""
"Der neu angegebenen Pfad %s ist absolut. Der neue Pfad muss ein Pfad relativ "
"zum WP-Uploads-Verzeichnis sein."

#. translators: %s is the path to a directory
#: includes/Main.php:1317
msgid "An error has occurred while creating the directory %s."
msgstr "Ein Fehler ist aufgetreten bei der Erstellung des Verzeichnis %s."

#. translators: 1: old file path, 2: new file path
#: includes/Main.php:1382
msgid "The file can not be moved from %1$s to %2$s."
msgstr "Die Datei kann nicht von %1$s nach %2$s verschoben werden."

