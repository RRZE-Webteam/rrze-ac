msgid "Login is required"
msgstr "Anmeldung ist erforderlich"

#: includes/Main.php:1643
msgid "You do not have sufficient permissions to access the file."
msgstr ""
"Sie verfügen nicht über ausreichende Berechtigungen, um auf die Datei "
"zugreifen zu können."

#: includes/Main.php:1670 includes/Main.php:1715
msgid "Permission does not exist or has been removed."
msgstr "Die Berechtigung ist nicht vorhanden oder wurde entfernt."

#: includes/Main.php:1674
msgid "Permission has been disabled."
msgstr "Berechtigung wurde deaktiviert."

#. translators: 1: Error message, 2: Default permission.
#: includes/Main.php:1686 includes/Main.php:1729
msgid ""
"An error has occurred: %1$s and has been replaced by the default permission "
"%2$s."
msgstr ""
"Ein Fehler ist aufgetreten: %1$s und ist durch die Standardberechtigung "
"&bdquo;%2$s&ldquo; ersetzt worden."

#: includes/Main.php:1719 includes/Settings.php:763
msgid "The permission has been disabled."
msgstr "Die Berechtigung wurde deaktiviert."

#: includes/Main.php:1781
msgid "Media file is now protected."
msgid_plural "%s media files are now protected."
msgstr[0] "Mediendatei ist nun geschützt."
msgstr[1] "%s Mediendateien sind nun geschützt."

#: includes/Main.php:1795
msgid "Data protection on Media file has been removed."
msgid_plural "Data protection on %s Media files has been removed."
msgstr[0] "Dateischutz auf Mediendatei entfernt."
msgstr[1] "Dateischutz auf %s Mediendateien entfernt."

#: includes/Main.php:1852
msgid "You are not allowed to add media files to the protected directory."
msgstr ""
"Sie sind nicht erlaubt, Mediendateien zu dem geschützten Verzeichnis "
"hinzuzufügen."

#: includes/Main.php:1875
msgid ""
"An error has occurred while moving the media files in the protected "
"directory."
msgstr ""
"Beim Verschieben der Mediendateien in das geschützte Verzeichnis ist ein "
"Fehler aufgetreten."

#: includes/Main.php:1876 includes/Main.php:1920
msgid "Internal Server Error"
msgstr "Internal Server Error"

#: includes/Main.php:1896
msgid "You are not allowed to remove media files from the protected directory."
msgstr ""
"Sie sind nicht erlaubt, Mediendateien von dem geschützten Verzeichnis zu "
"entfernen."

#: includes/Main.php:1919
msgid ""
"An error has occurred while removing the media files from the protected "
"directory."
msgstr ""
"Beim Entfernen der Mediendateien aus dem geschützten Verzeichnis ist ein "
"Fehler aufgetreten."

#: includes/Main.php:1985
msgid "New files are protected"
msgstr "Neue Dateien sind geschützt"

