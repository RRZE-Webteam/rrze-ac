msgstr ""
"<a href=\"%s\">Anmeldung über Single Sign-On (zentraler Anmeldedienst der "
"Universität Erlangen-Nürnberg)</a>."

#: includes/Main.php:2067
msgid "Access to this file is only possible for registered users."
msgstr "Der Zugriff auf diese Datei ist nur für angemeldete Benutzer möglich."

#: includes/Main.php:2069
