msgstr "Allow IP address"

#: ../rrze-ac.php:197
#, php-format
msgid ""
"Die PHP-Version %s ist veraltet. Bitte aktualisieren Sie mindestens auf die "
"PHP-Version %s."
msgstr ""
"Your server is running PHP version %s. Please upgrade at least to PHP "
"version %s."

#: ../rrze-ac.php:202
#, php-format
msgid ""
"Die Wordpress-Version %s ist veraltet. Bitte aktualisieren Sie mindestens "
"auf die Wordpress-Version %s."
msgstr ""
"Your Wordpress version is %s. Please upgrade at least to Wordpress version "
"%s."

#: ../rrze-ac.php:207
#, php-format
msgid ""
"Der Web-Server-Software %s ist nicht kompatibel. Bitte verwenden Sie "
"stattdessen den Apache-Web-Server-Software."
msgstr ""
"The Web server software %s is not compatible. Please use instead the Apache "
"Web server software."

#: ../rrze-ac.php:212
msgid ""
"Der Web-Server-Software ist nicht kompatibel. Bitte verwenden Sie "
"stattdessen den Apache-Web-Server-Software."
msgstr ""
"The Web server software is not compatible. Please use instead the Apache Web "
"server software."

#: ../rrze-ac.php:217
msgid "Die Wordpress-Instanz ist keine Multisite."
msgstr "The WordPress instance is not a MultiSite."

#: ../rrze-ac.php:222
msgid "Der Web-Server-Software unterstützt das Rewrite-Modul nicht."
msgstr "The Web server software does not support the Rewrite module."

#: ../rrze-ac.php:227
msgid "Die Konstant SECURE_AUTH_SALT ist nicht definiert."
msgstr "The constant SECURE_AUTH_SALT is undefined."

#: ../rrze-ac.php:232
msgid "Die mcrypt-Funktionen sind nicht definiert."
msgstr "The mcrypt functions are not defined."

#: ../rrze-ac.php:264
msgid ""
"Das RRZE-Access-Control-Plugin wurde nicht richtig konfiguriert. Die Dateien/"
"Dokumente können nicht geschützt werden."
msgstr ""
"The RRZE Access Control Plugin is not configured properly. The files and "
"documents can not be protected."

#: ../rrze-ac.php:267
msgid ""
"Die folgende Rewrite-Befehle müssen in der htaccess-Datei nach der WordPress-"
"Befehl &#8222;RewriteRule ^index\\.php$ - [L]&#8220; hinzugefügt werden."
msgstr ""
"The following rewrite commands must be added in the .htaccess file after the "
"WordPress command &#8222;RewriteRule ^index\\.php$ - [L]&#8220;"

#: ../rrze-ac.php:270
msgid "Bitte wenden Sie sich an den Systemadministrator."
msgstr "Please contact your system administrator."

#: ../rrze-ac.php:327 ../rrze-ac.php:328
msgid "Angemeldeten Benutzer"
msgstr "Logged-in user"

#: ../rrze-ac.php:339 ../rrze-ac.php:340
msgid "Alle"
msgstr "All"

#: ../rrze-ac.php:411 ../rrze-ac.php:656
msgid "Einstellungen"
msgstr "Settings"

#: ../rrze-ac.php:483 ../rrze-ac.php:647
msgid "Zugriffsschutz"
msgstr "Access Protection"

#: ../rrze-ac.php:501
msgid "Einträge pro Seite:"
msgstr "Items per page:"

#: ../rrze-ac.php:516 ../rrze-ac.php:526
msgid "IP-Adressen zulassen"
msgstr "Allow IP addresses"

#: ../rrze-ac.php:533
msgid "Standardberechtigung"
msgstr "Standard Permission"

#: ../rrze-ac.php:559
msgid "Der Benutzer muss angemeldet sein."
msgstr "The user must be logged in."

#: ../rrze-ac.php:570
msgid "Der Benutzer muss SSO angemeldet sein."
msgstr "The user must be SSO logged-in."

#: ../rrze-ac.php:648
msgid "Neu hinzufügen"
msgstr "Add New"

#: ../rrze-ac.php:655
msgid "Berechtigungen"
msgstr "Permissions"

#: ../rrze-ac.php:754 ../rrze-ac.php:759
msgid "Neue Berechtigung hinzufügen"
msgstr "Add New Permission"

#: ../rrze-ac.php:767 ../rrze-ac.php:1298
msgid "Berechtigung bearbeiten"
msgstr "Edit permission"

#: ../rrze-ac.php:772
msgid "Berechtigung aktualisieren"
msgstr "Update permission"

#: ../rrze-ac.php:821
msgid "Berechtigung erforderlich."
msgstr "Permission required."

#: ../rrze-ac.php:827
msgid "Berechtigung existiert bereits."
msgstr "Permission already exists."

#: ../rrze-ac.php:831 ../rrze-ac.php:864
msgid "Kurzbeschreibung erforderlich."
msgstr "Short description required."

#: ../rrze-ac.php:900
msgid "Die IP-Adresse ist nicht gültig."
msgstr "The IP address is not valid."

#: ../rrze-ac.php:935 ../rrze-ac.php:1229 ../rrze-ac.php:1753
#: ../rrze-ac.php:1791
msgid "Zugriffsbeschränkung"
msgstr "Access Restriction"

#: ../rrze-ac.php:1250 ../rrze-ac.php:1848
msgid "Berechtigung aktivieren"
msgstr "Enable permission"

#: ../rrze-ac.php:1251 ../rrze-ac.php:1850
msgid "Berechtigung entfernen"
msgstr "Remove permission"

#: ../rrze-ac.php:1293
msgid "Berechtigung:"
msgstr "Permission:"

#: ../rrze-ac.php:1309
msgid "OK"
msgstr "OK"

#: ../rrze-ac.php:1310
msgid "Abbrechen"
msgstr "Abort"

#: ../rrze-ac.php:1447
#, php-format
msgid "Das Post %d is kein Medien-Post-Type."
msgstr "The post %d is not a Media Post-Type."

#: ../rrze-ac.php:1453
#, php-format
msgid ""
"Der neu angegebenen Pfad %s ist absolut. Der neue Pfad muss ein Pfad relativ "
"zum WP-Uploads-Verzeichnis sein."
msgstr ""
"The newly specified path %s is absolute. The new path must be a path "
"relative to the WP uploads directory."

#: ../rrze-ac.php:1479
#, php-format
msgid "Ein Fehler ist aufgetreten bei der Erstellung des Verzeichnis %s"
msgstr "An error has occurred while creating the directory %s"

#: ../rrze-ac.php:1542
#, php-format
msgid "Die Datei kann nicht von %s nach %s verschoben werden."
msgstr "The file can not be moved from %s to %s."

#: ../rrze-ac.php:1599 ../rrze-ac.php:1609
msgid "Die angeforderte Datei wurde nicht gefunden."
msgstr "The requested file was not found."

#: ../rrze-ac.php:1619
msgid "Die Anfrage wurde mangels Berechtigung des Clients nicht durchgeführt."
msgstr "The request was due lack of client permission not performed."

#: ../rrze-ac.php:1746
msgid ""
"Sie verfügen nicht über ausreichende Berechtigungen, um auf die Datei "
"zugreifen zu können."
msgstr "You do not have sufficient permissions to access the file."

#: ../rrze-ac.php:1771 ../rrze-ac.php:1809
msgid "Berechtigung nicht vorhanden bzw. wurde entfernt"
msgstr "Permission does not exist or has been removed"

#: ../rrze-ac.php:1775 ../rrze-ac.php:1813
msgid "Berechtigung wurde deaktiviert"
msgstr "Permission has been disabled"

#: ../rrze-ac.php:1785 ../rrze-ac.php:1823
#, php-format
msgid ""
"Ein Fehler ist aufgetreten: %1$s und ist durch die Standardberechtigung "
"&bdquo;%2$s&ldquo; ersetzt worden."
msgstr ""
"An error has occurred: %1$s and has been replaced by the default permission "
"%2$s."

#: ../rrze-ac.php:1875
#, php-format
msgid "Mediendatei ist nun geschützt."
msgid_plural "%s Mediendateien sind nun geschützt."
msgstr[0] "Media file is now protected."
msgstr[1] "%s media files are now protected."

#: ../rrze-ac.php:1887
#, php-format
msgid "Dateischutz auf Mediendatei entfernt."
msgid_plural "Dateischutz auf %s Mediendateien entfernt."
msgstr[0] "Data protection on Media file has been removed."
msgstr[1] "Data protection on %s Media files has been removed."

#: ../rrze-ac.php:1938
msgid ""
"Sie sind nicht erlaubt, Mediendateien zu dem geschützten Verzeichnis "
"hinzuzufügen."
msgstr "You are not allowed to add media files to the protected directory."

#: ../rrze-ac.php:1955
msgid ""
"Ein Fehler ist aufgetreten als Sie versucht haben, die Mediendateien in dem "
"geschützten Verzeichnis zu verschieben."
msgstr ""
"An error has occurred when you tried to move the media files in the "
"protected directory."

#: ../rrze-ac.php:1969
msgid ""
"Sie sind nicht erlaubt, Mediendateien von dem geschützten Verzeichnis zu "
"entfernen."
msgstr ""
"You are not permitted to remove media files from the protected directory."

#: ../rrze-ac.php:1986
msgid ""
"Ein Fehler ist aufgetreten beim Verschieben der Mediendateien in dem "
"geschützten Verzeichnis."
msgstr ""
"An error has occurred while moving the media files in the protected "
"directory."

#: ../rrze-ac.php:2056
msgid "Zugiffsbeschränkung"
msgstr "Access Restriction"

#: ../rrze-ac.php:2082
msgid "Neue Dateien sind geschützt"
msgstr "New files are protected"

#: ../rrze-ac.php:2132
#, php-format
msgid ""
"Der Zugriff auf diese Seite ist nur für Mitglieder dieser Webseite möglich. "
"<a href=\"%s\">Bitte melden Sie sich mit Ihrer IdM-Kennung an</a>, um den "
"Inhalt der Seite zu sehen."
msgstr ""
"Access to this page is only available to members of this site. <a href=\"%s"
"\">Please login with your IdM identifier</a> to see the contents of the page."

#: ../rrze-ac.php:2135
#, php-format
msgid ""
"Der Zugriff auf diese Datei ist nur für Mitglieder dieser Webseite möglich. "
"<a href=\"%s\">Bitte melden Sie sich mit Ihrer IdM-Kennung an</a>, um die "
"Datei herunterzuladen."
msgstr ""
"Access to this file is only available for members of this website. <a href="
"\"%s\">Please login with your IdM identifier</a>, to download the file."

#: ../rrze-ac.php:2137
msgid ""
"Sie verfügen nicht über ausreichende Berechtigungen, um die Seite anzusehen. "
"Falls Sie glauben, Sie müssten Zugriff auf die Seite haben, bitte "
"kontaktieren Sie den Ansprechpartner der Webseite."
msgstr ""
"You do not have sufficient permissions to view this page. If you believe you "
"should have access to the page, please get in touch with the contact person "
"of the website."

#: ../rrze-ac.php:2139
msgid ""
"Sie verfügen nicht über ausreichende Berechtigungen, um auf die Datei "
"zugreifen zu können. Falls Sie glauben, Sie müssten Zugriff auf die Datei "
"haben, bitte kontaktieren Sie den Ansprechpartner der Webseite."
msgstr ""
"You do not have sufficient permissions to access the file. If you believe "
"you should have access to the file, please get in touch with the contact "
"person of the website."

#: ../rrze-ac.php:2141
msgid ""
"Sie verfügen nicht über ausreichende Berechtigungen, um diesen Bereich "
"anzusehen. Falls Sie glauben, Sie müssten Zugriff auf diesen Bereich haben, "
"bitte kontaktieren Sie den Ansprechpartner der Webseite."
msgstr ""
"You do not have sufficient permissions to view this resource. If you believe "
"you should have access to this resource, please get in touch with the "
"contact person of the website."

#: ../rrze-ac.php:2213
msgid "Ein Fehler ist aufgetreten: Verschlüsselung des Inhalts fehlgeschlagen."
msgstr "An error has occurred: content encryption failed."

