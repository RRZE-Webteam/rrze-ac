#: ../includes/list-table.php:83 ../rrze-ac.php:517 ../rrze-ac.php:527
msgid "Kurzbeschreibung"
msgstr "Short Description"

#: ../includes/list-table.php:84 ../rrze-ac.php:518 ../rrze-ac.php:528
msgid "Beschreibung"
msgstr "Description"

#: ../includes/list-table.php:85 ../rrze-ac.php:514 ../rrze-ac.php:524
